# Server-side WordPress credentials. Never commit .env or real secrets.
WORDPRESS_URL=https://dev-mrkofficial786.pantheonsite.io
WORDPRESS_USERNAME=mrk786
WORDPRESS_APP_PASSWORD=replace-with-wordpress-application-password

# Protect the remote MCP endpoint. Keep this token separate from the dashboard password.
MCP_AUTH_TOKEN=replace-with-long-random-token
DASHBOARD_PASSWORD=replace-with-a-separate-dashboard-password

# Optional browser-local AI settings
GEMINI_MODEL=gemini-3.8-flash
MCP_SERVER_URL=https://mcpserver-drab.vercel.app/api/mcp


# OAuth 2.1 / ChatGPT MCP
OAUTH_ISSUER=https://mcpserver-drab.vercel.app
MCP_RESOURCE_URL=https://mcpserver-drab.vercel.app/api/mcp
OAUTH_SIGNING_SECRET=replace-with-a-long-random-secret-at-least-32-characters
OAUTH_USERNAME=mrk786
# Prefer a separate password; if omitted, DASHBOARD_PASSWORD is used.
OAUTH_PASSWORD=replace-with-a-private-oauth-password
